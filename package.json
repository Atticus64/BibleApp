{
  "name": "bibleapp",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --fix src/**/*.{js,svelte}",
    "lint:check": "eslint src/**/*.{js,svelte}",
    "validate": "pnpm format && pnpm check && pnpm lint",
