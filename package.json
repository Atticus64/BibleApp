  "dependencies": {
    "@sweetalert2/theme-dark": "^5.0.15",
    "@tiptap/core": "^2.1.13",
    "@tiptap/extension-blockquote": "^2.1.13",
    "@tiptap/extension-image": "^2.1.13",
    "@tiptap/pm": "^2.1.13",
    "@tiptap/starter-kit": "^2.1.13",
    "atropos": "^2.0.2",
    "sweetalert2": "^11.7.18"
